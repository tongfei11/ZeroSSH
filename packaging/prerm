#!/bin/sh
set -eu
case "${1:-}" in remove|upgrade|deconfigure)
getent passwd | while IFS=: read -r name unused uid gid gecos home shell; do
    if [ -S "/run/user/$uid/bus" ]; then
        runuser -u "$name" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user stop zero-ssh.service zero-ssh.socket || true
    fi
done
;; esac
