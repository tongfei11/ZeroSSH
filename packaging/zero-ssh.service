[Unit]
Description=Zero SSH session manager
Requires=zero-ssh.socket
After=zero-ssh.socket

[Service]
Type=simple
WorkingDirectory=/usr/lib/zero-ssh
Environment=ZERO_SSH_MODE=device
Environment=CARDPUTER_DATA_DIR=%h/.local/state/zero-ssh
ExecStart=/usr/bin/node /usr/lib/zero-ssh/server.mjs
UMask=0077
TimeoutStopSec=3
